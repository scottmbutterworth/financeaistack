# Postgres connection string. On Vercel, use the Neon Marketplace database
# (pooled host is fine). postgres.js is used for the app, migrations, and seed.
# Local example:
# DATABASE_URL=postgres://finance:finance@127.0.0.1:5432/financeaistack
DATABASE_URL=

# Resend API key. Used to add newsletter contacts, email sponsor inquiries
# to OWNER_EMAIL, and create a draft broadcast. Never commit a real key.
RESEND_API_KEY=

# Resend segment id for the newsletter audience. Resend replaced Audiences
# with Segments; put the segment id here (the value broadcasts and contacts
# expect). The variable name stays RESEND_AUDIENCE_ID so existing setups match.
RESEND_AUDIENCE_ID=

# Bearer token for every /api/admin/* route. Send as: Authorization: Bearer <token>
ADMIN_TOKEN=

# Inbox that receives sponsor "Get in touch" emails.
OWNER_EMAIL=

# From address for Resend. Use a verified domain, for example:
# Finance AI Stack <news@financeaistack.com>
FROM_EMAIL=

# Public site origin used in canonical URLs, the sitemap, and newsletter links.
# Optional. Defaults to https://financeaistack.com
NEXT_PUBLIC_SITE_URL=https://financeaistack.com
